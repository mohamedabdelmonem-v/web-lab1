		<style id="wp-custom-css">
			/* =======================================================
   1. 针对韩语(ko)等 LTR 语言，防止文字折行撕裂
   ======================================================= */
html[lang="ko"] .experience-box .elementor-icon-list-item {
    display: inline-flex !important;
    white-space: nowrap !important; /* 强制韩语在一行内完整显示，不发生左右撕裂 */
}

/* =======================================================
   2. 针对阿拉伯语(ar)和乌尔都语(ur)等 RTL 从右向左语言的排版崩坏
   ======================================================= */
/* 强制 RTL 模式下这个小部件依然使用相对温和的排列定位 */
html[dir="rtl"] .experience-box {
    position: relative;
    /* 清除可能导致重叠的绝对定位偏移 */
    left: auto !important; 
    right: auto !important;
    margin-inline-start: 15px !important; /* 根据 RTL 自动在起始端(右侧)留出间距，避免与 Logo 挤压 */
    text-align: right !important;
}

/* 微调 RTL 下列表项的内部方向 */
html[dir="rtl"] .experience-box .elementor-icon-list-item {
    direction: rtl !important;
}

/* 优化方案：使用 :lang(ko) 伪类，自动匹配任何格式的韩语标签 */
:lang(ko) body:not(.rtl) .elementor-16 .elementor-element.elementor-element-9466ff1 {
    left: -790px;
}


/* 强行修复 RTL 语言下产品大图位移失效问题 */
.rtl .woocommerce-product-gallery__wrapper {
    direction: ltr !important; 
}
/* 保证缩略图本身在 RTL 下能对齐 */
.rtl .woocommerce-product-gallery__image {
    direction: rtl !important;
}
