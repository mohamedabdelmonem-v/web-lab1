		if (action.indexOf('?s=') !== -1 || action.indexOf('search=') !== -1 || /\/search(\/?|\?|$)/.test(action)) { return true; }
		if (form.querySelector('input[type="search"],input[name="s"],input[name*="search"]')) { return true; }
		return false;
	}
