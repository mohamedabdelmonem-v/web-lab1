/* outline_jump scripts: */ 

// 获取指定的模块
var contentDiv = document.querySelector('.textcenter');

// 获取 h2 和 h3 标签，并过滤掉无文字或包含图片的标题
var headings = Array.from(contentDiv.querySelectorAll('h2, h3')).filter(heading => {
    const textContent = heading.textContent.trim();
    if (!textContent) return false;
    if (heading.querySelector('img')) return false;
    return true;
});

// 若无有效标题，则隐藏导航
function checkHeadingsAndHideNavigation() {
    if (headings.length === 0) {
        var navigation = document.querySelector('.headings-navigation');
        if (navigation) {
            navigation.style.display = 'none';
        }
    }
}
checkHeadingsAndHideNavigation();

// 生成目录列表
function generateTableOfContents() {
    var tocList = document.getElementById('toc-list');
    let h2Counter = 0;
    let h3Counter = 0;

    headings.forEach((heading, index) => {
        var anchorId = 'heading-' + index;
        heading.id = anchorId;

        if (heading.tagName.toLowerCase() === 'h2') {
            h2Counter++;
            h3Counter = 0;
            tocList.innerHTML += `<li class="toc-item"><a href="#${anchorId}" class="toc-link">${h2Counter}. ${heading.innerText}</a></li>`;
        } else if (heading.tagName.toLowerCase() === 'h3') {
            h3Counter++;
            tocList.innerHTML += `<li class="toc-item toc-sub-item"><a href="#${anchorId}" class="toc-link">${h2Counter}.${h3Counter} ${heading.innerText}</a></li>`;
        }
    });
}
generateTableOfContents();

// 点击目录项，平滑滚动到对应标题
document.querySelectorAll('.toc-item a').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = this.getAttribute('href').substring(1);
        var targetHeading = document.getElementById(targetId);
        if (!targetHeading) return;

        var rect = targetHeading.getBoundingClientRect();
        var offsetTop = rect.top + window.pageYOffset; // 元素相对页面顶部的距离
        var fixedOffset = 200; // 你想要保留的顶部偏移

        window.scrollTo({
            top: offsetTop - fixedOffset,
            behavior: 'smooth'
        });
    });
});

/* Right-to-top scripts: */ 

// Check if the page is already at the top and fade out the '.right-fix .toTop' element  
if (window.pageYOffset === 0) {  
  var toTopElement = document.querySelector(".right-fix .toTop");  
  toTopElement.style.opacity = 0;  
}  

// Listen for the scroll event on the window  
window.addEventListener('scroll', function(event) {  
  // Check if the page is at the top  
  if (window.pageYOffset === 0) {  
    var toTopElement = document.querySelector(".right-fix .toTop");  
    toTopElement.style.opacity = 0; // Fade out  
    toTopElement.style.transition = 'opacity 0.5s';  


  } else {  
    var toTopElement = document.querySelector(".right-fix .toTop");  
    toTopElement.style.opacity = 1; // Fade in  
    toTopElement.style.transition = 'opacity 0.5s';  


  }  
});  

// Listen for click event on the '.right-fix .toTop' element  
var toTopElement = document.querySelector(".right-fix .toTop");  
toTopElement.addEventListener('click', function(event) {  
  // Scroll to the top of the page  
  window.scrollTo({  
    top: 0,  
    behavior: 'smooth'  
  });  
});

