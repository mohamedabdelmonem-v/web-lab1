      scrollToTop(objTabTop, g_scrollOffset);
    
    if (g_dataScrollToHashedTab == "mobile" && window.matchMedia("(max-width: 1024px)").matches)
	  scrollToTop(objTabTop, g_scrollOffset);
    
    if (g_dataScrollToHashedTab == "desktop+mobile")
      scrollToTop(objTabTop, g_scrollOffset);  
  }   
     
  /**
