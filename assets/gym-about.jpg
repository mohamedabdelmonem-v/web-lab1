<style>/* widget: Side Menu */

#uc_ue_side_menu_elementor_0b17680 *{
  box-sizing:border-box;
  -webkit-box-sizing: border-box;
  -moz-box-sizing: border-box;
}

body.uc-menu-push{
  	transition: padding-left 1s, padding-right 1s;
}

.swiper-container{
  transition: transform 1s;
}

  body.menu-opened{
      overflow: hidden;
  }

#uc_ue_side_menu_elementor_0b17680 .uc-side-menu-wrapper{
  position:relative;
}

#uc_ue_side_menu_elementor_0b17680 .uc-menu-button-wrapper{
  position: relative;
  display: flex;
}

#uc_ue_side_menu_elementor_0b17680 .menu-right-open {
	width: 300px;
	top: 0;
	right: 0;
	margin-right: 0px;
	margin-left: 0px;
	transition: 1s;
	z-index: 999999;
	position: fixed;
}

#uc_ue_side_menu_elementor_0b17680 .menu-right-close {
	width: 300px;
	top: 0;
	right: 0;
	margin-right: -300px;
	transition: 1s;
	z-index: 1;
	height: 100%;
	position: fixed;
}

#uc_ue_side_menu_elementor_0b17680 .menu-left-open {
	width: 300px;
	top: 0;
	left: 0;
	margin-right: 0px;
	margin-left: 0px;
	transition: 1s;
	z-index: 999999;
	height: 100%;
	position: fixed;
}

#uc_ue_side_menu_elementor_0b17680 .menu-left-close {
	width: 300px;
	top: 0;
	left: 0;
	margin-left: -300px;
	transition: 1s;
	z-index: 1;
	height: 100%;
	position: fixed;
}
	
#uc_ue_side_menu_elementor_0b17680 .uc-menu-item-pointer,
#uc_ue_side_menu_elementor_0b17680 .ue-back-link-icon{
    display: inline-block;
    margin:0px 15px;
    vertical-align: middle;
    transition: all 1s ease;
}

#uc_ue_side_menu_elementor_0b17680 .uc-side-menu-items{
  position:relative;
  height:100vh;
  overflow-x: hidden;
  transition:1s;
  display:flex;
  flex-direction:column;
}

#uc_ue_side_menu_elementor_0b17680 .open_side_menu{
  cursor:pointer;
  align-items:center;
  justify-content:center;
  transition: 0.4s ease;
  position: relative;
  line-height:1em;
      	display: flex;
  }

#uc_ue_side_menu_elementor_0b17680 .open_side_menu svg{
  height:1em;
  width:1em;
}

#uc_ue_side_menu_elementor_0b17680 .open_side_menu_toggle{
  position: relative;
  -webkit-box-flex: 0;
  flex: none;
  width: 100%;
  height: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s ease;
}

#uc_ue_side_menu_elementor_0b17680 .open_side_menu_toggle:before,
#uc_ue_side_menu_elementor_0b17680 .open_side_menu_toggle:after {
  content: '';
  position: absolute;
  z-index: 1;
  top: -10px;
  left: 0;
  width: 100%;
  height: 2px;
  background: inherit;
}
	
#uc_ue_side_menu_elementor_0b17680 .open_side_menu_toggle:after {
  top: 10px;
}

	

#uc_ue_side_menu_elementor_0b17680 .open_side_menu.uc-close-action .open_side_menu_toggle{
  -webkit-transform: rotate(90deg);
  transform: rotate(135deg);
}
#uc_ue_side_menu_elementor_0b17680 .open_side_menu.uc-close-action .open_side_menu_toggle:before,
#uc_ue_side_menu_elementor_0b17680 .open_side_menu.uc-close-action .open_side_menu_toggle:after{
  top: 0;
  -webkit-transform: rotate(90deg);
  transform: rotate(90deg);
}

#uc_ue_side_menu_elementor_0b17680 .open_side_menu.uc-close-action .open_side_menu_toggle:after{
 opacity: 0;
}

#uc_ue_side_menu_elementor_0b17680 .open_side_menu.uc-close-action:hover .open_side_menu_toggle{
  -webkit-transform: rotate(225deg);
  transform: rotate(225deg);
}

#uc_ue_side_menu_elementor_0b17680 .uc-side-menu-title{
  text-align:left;
}

.menu-left-open .uc-close-side-menu, .menu-right-open .uc-close-side-menu{
  display:flex;
  opacity:1;
}

.menu-left-close .uc-close-side-menu, .menu-right-close .uc-close-side-menu{
  display:none;
}

.uc-close-side-menu{
  line-height:1em;
}

.uc-close-side-menu svg{
  height:1em;
  width:1em;
}

#uc_ue_side_menu_elementor_0b17680 .side-menu-before{
    margin-right: auto;
  }

#uc_ue_side_menu_elementor_0b17680 .side-menu-after{
  flex-grow:1;
  display:flex;
    margin-right: auto;
  }
  
#uc_ue_side_menu_elementor_0b17680 .menu-left-open .ue_side_menu_overlay, 
#uc_ue_side_menu_elementor_0b17680 .menu-right-open .ue_side_menu_overlay{
  display:block;
  opacity:1;
  transition:1s;
}

#uc_ue_side_menu_elementor_0b17680 .menu-left-close .ue_side_menu_overlay, 
#uc_ue_side_menu_elementor_0b17680 .menu-right-close .ue_side_menu_overlay{
  display:none;
  opacity:0;
  transition:1s;
}

#uc_ue_side_menu_elementor_0b17680 .uc-close-side-menu{
  position:absolute;
  right:-50px;
  cursor:pointer;
  justify-content:center;
  align-items:center;
  z-index:1;
}


#uc_ue_side_menu_elementor_0b17680 .uc-side-menu-items ul{
  padding:0px;
  margin-left:0px;
  margin-right: 0;
  margin-bottom: 0;
  list-style:none;
}

#uc_ue_side_menu_elementor_0b17680 .uc-side-menu-items ul a{
