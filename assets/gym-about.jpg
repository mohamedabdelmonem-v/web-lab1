  function scrollToHashedTab(){  
  	var dataHash = jQuerytabs.data("hash");
    
    if(dataHash == false)
    return(false);
        
    if(g_dataScrollToHashedTab == "off")
    return(false); 
    
    var objHash = getHashedTab();
    
    if(!objHash || !objHash.length || objHash == false)
    return(false); 
      
    var objHashTop = objHash.offset().top;
    
    scrollToTab(objHash);      	
  } 
     
  /**
